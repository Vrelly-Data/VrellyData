{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/resources/:slug", "destination": "/api/article/:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/resources", "destination": "/api/marketing?name=resources" },
    { "source": "/pricing", "destination": "/api/marketing?name=pricing" },
    { "source": "/features", "destination": "/api/marketing?name=features" },
    { "source": "/comparisons", "destination": "/api/marketing?name=comparisons" },
    { "source": "/demo", "destination": "/api/marketing?name=demo" },
    { "source": "/agents", "destination": "/api/marketing?name=agents" },
    { "source": "/privacy", "destination": "/api/marketing?name=privacy" },
    { "source": "/terms", "destination": "/api/marketing?name=terms" },

    // Private/app routes: serve SPA shell but ensure noindex,nofollow in initial HTML
    { "source": "/auth", "destination": "/api/marketing?name=private" },
    { "source": "/dashboard", "destination": "/api/marketing?name=private" },
    { "source": "/admin", "destination": "/api/marketing?name=private" },
    { "source": "/billing", "destination": "/api/marketing?name=private" },
    { "source": "/settings", "destination": "/api/marketing?name=private" },
    { "source": "/playground", "destination": "/api/marketing?name=private" },
    { "source": "/people", "destination": "/api/marketing?name=private" },
    { "source": "/companies", "destination": "/api/marketing?name=private" },
    { "source": "/choose-plan", "destination": "/api/marketing?name=private" },
    { "source": "/checkout-success", "destination": "/api/marketing?name=private" },
    { "source": "/reset-password", "destination": "/api/marketing?name=private" },

    // Known dead marketing paths: return real 404 HTML
    { "source": "/how-it-works", "destination": "/api/marketing?name=not-found" },
    { "source": "/faq", "destination": "/api/marketing?name=not-found" },

    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    // Apex domain → www (permanent)
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "vrelly.com" }],
      "destination": "https://www.vrelly.com/$1",
      "statusCode": 308
    },
    // Trailing-slash variants → slashless (permanent)
    { "source": "/resources/", "destination": "/resources", "statusCode": 308 },
    { "source": "/features/", "destination": "/features", "statusCode": 308 },
    { "source": "/pricing/", "destination": "/pricing", "statusCode": 308 },
    { "source": "/comparisons/", "destination": "/comparisons", "statusCode": 308 },
    { "source": "/agents/", "destination": "/agents", "statusCode": 308 },
    { "source": "/demo/", "destination": "/demo", "statusCode": 308 },

    // Legacy /login → /auth
    { "source": "/login", "destination": "/auth", "statusCode": 301 },

    { "source": "/blog", "destination": "/resources", "statusCode": 301 },
    { "source": "/blog/", "destination": "/resources", "statusCode": 301 }
  ]
}
